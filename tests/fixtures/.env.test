# Minimal test .env with placeholder values for compose validation
# Used by: docker compose config --env-file tests/fixtures/.env.test

MEDIA_ROOT=/tmp/test-media
TZ=UTC
PUID=1000
PGID=1000
RENDER_GROUP_ID=0

VPN_SERVICE_PROVIDER=surfshark
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
WIREGUARD_ADDRESSES=10.14.0.2/16
VPN_COUNTRIES=United Kingdom

NAS_IP=192.168.1.100
PIHOLE_UI_PASS=test_placeholder_password
TRAEFIK_LAN_IP=192.168.1.11
TRAEFIK_LAN_MAC=02:42:c0:a8:01:0b
LAN_INTERFACE=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

DOMAIN=test.example.com
TRAEFIK_DASHBOARD_AUTH='admin:$2y$05$placeholder_bcrypt_hash_here'

PLEX_CLAIM=claim-test_placeholder
QBIT_USER=admin
QBIT_PASSWORD=test_placeholder
BESZEL_KEY=test_placeholder_key
