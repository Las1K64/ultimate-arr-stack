{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "forkProcessing": "enabled",
  "timezone": "Europe/London",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Group all LinuxServer.io image updates",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^lscr\\.io/linuxserver//"
      ],
      "groupName": "LinuxServer.io images"
    },
    {
      "description": "qBittorrent's registry still carries 20.04.x tags from old Ubuntu-based builds; they sort above 5.x but are years older",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "lscr.io/linuxserver/qbittorrent"
      ],
      "allowedVersions": "<20"
    },
    {
      "description": "Group infrastructure images (Gluetun, Traefik, Cloudflared, Pi-hole)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "qmcgaw/gluetun",
        "traefik",
        "cloudflare/cloudflared",
        "pihole/pihole"
      ],
      "groupName": "Infrastructure images"
    },
    {
      "description": "Group monitoring/utility images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "henrygd/beszel",
        "henrygd/beszel-agent",
        "louislam/uptime-kuma",
        "crazymax/diun",
        "qmcgaw/deunhealth",
        "mkoestler/duc-service"
      ],
      "groupName": "Utility images"
    }
  ],
  "prBodyNotes": [
    "**Test on the NAS before merging.** Check out this branch on the NAS, recreate the affected services through their own compose files (never `--remove-orphans`), verify them and run `npm run test:e2e`. See CLAUDE.md, *Deploying to the NAS*."
  ]
}
